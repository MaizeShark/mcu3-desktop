# Whitelist: only the tools are tracked. Firmware dumps, ext4 images, backups and
# build output in this folder stay local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/docs/
!/CLAUDE.md
!/start_all.sh
!/tesla
!/tesla.conf.example
!/tools/
!/sandbox.sh
!/mcu2-patchkit/
!/tesla-touch/
!/notes/
!/navigation/
!/vehicle/
!/bluetooth/

/mcu2-patchkit/downloads/
# downloaded / built by mcu2_patch.py (sources.toml, src/); never commit the libraries
/mcu2-patchkit/payload/
__pycache__/
/tesla-touch/target/
/navigation/work/
/vehicle/work/
